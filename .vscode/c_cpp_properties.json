{
  "version": 4,
  "configurations": [
    {
      "name": "linux-gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/**",
        "/usr/local/cuda/include",
        "/usr/local/cuda/include/cccl",
        "${workspaceFolder}/.venv/lib/python3.12/site-packages/torch/include",
        "${workspaceFolder}/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include",
        "${env:HOME}/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12"
      ],
      "defines": [
        "__CUDACC__",
        "__CUDA_ARCH__=800"
      ],
      "forcedInclude": [
        "/usr/local/cuda/include/cuda_runtime.h"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/src",
          "/usr/local/cuda/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
